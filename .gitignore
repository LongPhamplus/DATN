__pycache__/
*.pyc
.pytest_cache/
.venv/

# group-V scenarios are regenerated from scripts/assign_cves.py; hashes in scenarios/V/MANIFEST.json
scenarios/V*/*.json
!scenarios/V*/MANIFEST.json

# group-V raw outputs are large; regenerate with scripts/run_group_v.sh
out/policies/V*/*/curves.csv
out/policies/V*/*/summary.csv

# NASim-generated networks (group G); regenerate with scripts/run_nasim_gen.sh
scenarios/G/*.json
scenarios/G_cve/*.json
!scenarios/G_cve/MANIFEST.json
out/nasim_gen/raw.json
# OWASP policy experiment raw outputs; regenerate with python -m aapef.owasp_experiment
out/owasp/*/curves.csv
out/owasp/*/summary.csv
